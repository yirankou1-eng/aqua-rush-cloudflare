{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aqua-rush-gp",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/socket", "/health"],
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "RaceRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RaceRoom"]}],
  "observability": {"enabled": false}
}
